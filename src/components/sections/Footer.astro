---
import { contact } from '../../data/contact';
import { navLinks } from '../../data/nav';
---
<footer class="bg-[#001c2c] py-14 text-sm text-background/65 md:py-20">
  <div class="section-shell">
    <div class="grid gap-px bg-transparent md:grid-cols-[1.3fr_0.8fr_0.9fr]">
      <div class="rounded-xl bg-[#001c2c] p-5 md:p-7">
        <img src="/brand/logo-horizontal-white.png" alt="G&S Conexiones Estratégicas" class="h-10 w-auto" />
        <p class="mt-10 max-w-[18ch] font-heading text-3xl font-semibold uppercase leading-none text-background">Conectamos tu negocio, optimizamos tu camino.</p>
      </div>
      <div class="rounded-xl bg-[#001c2c] p-5 md:p-7">
        <h3 class="mb-5 text-[9px] font-semibold uppercase tracking-[0.16em] text-accent">Manifiesto / navegación</h3>
        <nav aria-label="Footer" class="border-t border-background/15">
          {navLinks.map((link) => (
            <a href={link.href} class="block border-b border-background/15 py-3 transition-colors hover:text-accent">
              {link.label}
            </a>
          ))}
          <a href="#contacto" class="block border-b border-background/15 py-3 transition-colors hover:text-accent">
            Contacto
          </a>
        </nav>
      </div>
      <div class="rounded-xl bg-[#001c2c] p-5 md:p-7">
        <h3 class="mb-5 text-[9px] font-semibold uppercase tracking-[0.16em] text-accent">Punto de contacto</h3>
        <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="block font-heading text-2xl font-semibold text-background transition-colors hover:text-accent">
          Escríbenos por WhatsApp
        </a>
        <span class="mt-2 block">Antioquia, Colombia</span>
        <a href="#hero" class="mt-12 inline-flex h-12 w-12 items-center justify-center rounded-full border border-background/20 text-background transition-colors hover:border-accent hover:text-accent" aria-label="Volver al inicio">↑</a>
      </div>
    </div>
    <div class="mt-8 flex flex-col gap-3 border-t border-background/15 pt-5 text-[9px] uppercase tracking-[0.14em] text-background/35 sm:flex-row sm:justify-between">
      <span>&copy; {new Date().getFullYear()} G&amp;S Conexiones Estratégicas</span>
      <span>Transporte de carga / Colombia</span>
    </div>
  </div>
</footer>
